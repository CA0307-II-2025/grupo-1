library(ggplot2)
library(cowplot)
ggplot(
df_gam,
aes(x = ob_mean, y = Canton, color = GAM)
) +
# barras verticales: intervalo de confianza de cada punto
geom_errorbar(
aes(ymin = ob_q2.5, ymax = ob_q97.5),
width = 0,        # sin "patitas" horizontales (solo línea vertical)
alpha = 0.3       # un poco transparente para que no sature
) +
# el punto central (estimación)
geom_point(alpha = 0.7) +
scale_color_manual(values = c("GAM" = "steelblue", "NO GAM" = "orange")) +
labs(
x = "Edad",
y = "Ingreso promedio",
color = "Zona",
title = "Ingreso vs Edad con IC por observación"
) +
theme_cowplot()
