library(ggplot2)
library(cowplot)
ggplot(df_gam) +
# 1. Barras de IC
geom_errorbar(
aes(
x    = ob_mean,
ymin = ob_q2.5,
ymax = ob_q97.5,
colour = GAM
),
width = 0.1,    # patitas horizontales pequeñas para que se vea
alpha = 0.7
) +
# 2. Punto central (estimación)
geom_point(
aes(
x = x_var,
y = y_hat,
colour = GAM
),
size  = 1.8,
alpha = 0.9
) +
theme_cowplot() +
labs(
x = "Eje X",
y = "Eje Y",
colour = "Zona"
)
