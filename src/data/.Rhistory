"Alajuela", "Alajuela",
"Alajuela", "Atenas",
"Alajuela", "Poás",
"Cartago",  "Cartago",
"Cartago",  "Paraíso",
"Cartago",  "La Unión",
"Cartago",  "Oreamuno",
"Cartago",  "Alvarado",
"Cartago",  "El Guarco",
"Heredia",  "Heredia",
"Heredia",  "Barva",
"Heredia",  "Santo Domingo",
"Heredia",  "Santa Bárbara",
"Heredia",  "San Rafael",
"Heredia",  "San Isidro",
"Heredia",  "Belén",
"Heredia",  "Flores",
"Heredia",  "San Pablo"
)
gam_cantones_key <- gam_cantones |>
mutate(
CANTON_KEY = canton |>
stri_trans_general("Latin-ASCII") |>
toupper() |>
trimws(),
GAM = "GAM"
) |>
select(CANTON_KEY, GAM)
df_gam <- df %>%
left_join(gam_cantones_key, by = c("canton" = "CANTON_KEY")) %>%
mutate(
GAM = if_else(is.na(GAM), "NO GAM", GAM)
)
View(df)
df_gam <- df %>%
left_join(gam_cantones_key, by = c("Canton" = "CANTON_KEY")) %>%
mutate(
GAM = if_else(is.na(GAM), "NO GAM", GAM)
)
df_gam
library(ggplot2)
ggplot(df_gam, aes(x = ob_mean, y = Canton, color = GAM)) +
geom_point(alpha = 0.7) +
scale_color_manual(values = c("GAM" = "steelblue", "NO GAM" = "orange")) +
labs(
x = "Nombre eje X",
y = "Nombre eje Y",
color = "Zona",
title = "Relación entre var_x y var_y por pertenencia a la GAM"
) +
theme_minimal()
ggplot(df_gam, aes(x = ob_mean, y = Canton, color = GAM)) +
geom_point(alpha = 0.7) +
scale_color_manual(values = c("GAM" = "steelblue", "NO GAM" = "orange")) +
labs(
x = "Nombre eje X",
y = "",
color = "Zona",
title = "Relación entre var_x y var_y por pertenencia a la GAM"
) +
theme_minimal(axis.ticks.y = element_blank())
