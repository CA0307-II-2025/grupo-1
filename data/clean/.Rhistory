filter(n_vecinos_max - n_vecinos_min <= 10) %>%   # ← este filtro adicional
mutate(anios_base = list(combinaciones_anios)) %>%
unnest(anios_base)
parametros <- parametros %>%
mutate(
id = row_number(),  # identificador único
anios_chr = map_chr(anios_base, ~ paste(., collapse = "_"))
)
# Carpeta donde se guardarán los resultados parciales
dir.create("resultados_temp", showWarnings = FALSE)
# Archivos ya procesados
procesados <- list.files("resultados_temp", pattern = "^res_\\d+\\.rds$")
ids_procesados <- as.integer(gsub("res_(\\d+)\\.rds", "\\1", procesados))
# Filtrar combinaciones que no han sido procesadas aún
pendientes <- parametros %>% filter(!(id %in% ids_procesados))
plan(multisession, workers = 3)
future_pmap(
list(
pendientes$n_vecinos_min,
pendientes$n_vecinos_max,
pendientes$n_ventana,
pendientes$anios_base,
pendientes$id
),
function(n_min, n_max, ventana, anios, id_actual) {
resultados_base <- tica %>% filter(format(Fecha, "%Y") %in% as.character(anios))
anio_max <- max(anios)
predecir <- tica %>% filter(format(Fecha, "%Y") == as.character(anio_max))
if (nrow(resultados_base) == 0 || nrow(predecir) < 2) return(NULL)
res <- simular_vecinos_sorteos_2025_parallel(
resultados = resultados_base,
predecir = nica,
n_vecinos_min = n_min,
n_vecinos_max = n_max,
n_ventana = ventana,
workers = 1
)
saveRDS(res, file = sprintf("resultados_temp/res_%d.rds", id_actual))
NULL
}
)
