future_pmap(
list(
pendientes$n_vecinos_min,
pendientes$n_vecinos_max,
pendientes$n_ventana,
pendientes$anios_base,
pendientes$id
),
function(n_min, n_max, ventana, anios, id_actual) {
resultados_base <- tica %>% filter(format(Fecha, "%Y") %in% as.character(anios))
anio_max <- max(anios)
predecir <- tica %>% filter(format(Fecha, "%Y") == as.character(anio_max))
if (nrow(resultados_base) == 0 || nrow(predecir) < 2) return(NULL)
res <- simular_vecinos_sorteos_2025_parallel(
resultados = resultados_base,
predecir = nica,
n_vecinos_min = n_min,
n_vecinos_max = n_max,
n_ventana = ventana,
workers = 1
)
saveRDS(res, file = sprintf("resultados_temp/res_%d.rds", id_actual))
NULL
}
)
# Cargar paquetes necesarios
library(tidyverse)
library(ggplot2)
library(scales)
# Leer base consolidada
tica <- read.csv("tiempos_mega.csv", encoding = "UTF-8") %>%
mutate(Hora = ifelse(is.na(Hora), "Mediodía", Hora))
nica <- read.csv('loto_nicaragua_resultados_con_fechas.csv') %>%
filter(Jugada == 'Diaria') %>% select(Fecha, Jugada, Hora, Número = Resultado)
nica$Número <- str_extract(nica$Número, "^\\d{2}")
nica$Fecha <- str_c(nica$Fecha, "2025") %>% dmy()
# Asegurarse de que las columnas de interés son texto
tica$Número <- as.numeric(tica$Número)
tica$Reventado <- as.character(tica$Reventado)
tica$Mega <- as.character(tica$Mega)
tica$Fecha <- as.Date(tica$Fecha)
simular_vecinos_sorteos_2025 <- function(df, n_vecinos_min = 5, n_vecinos_max = 15, n_ventana = 1) {
# Asegurar formato de fecha
df$Fecha <- as.Date(df$Fecha)
# Ordenar cronológicamente
df <- df[order(df$Fecha), ]
# Filtrar sorteos de 2025
df_2025 <- df[format(df$Fecha, "%Y") == "2025", ]
if (nrow(df_2025) < 2) stop("No hay suficientes sorteos en 2025")
# Extraer sorteos de agosto
df_agosto <- df_2025[format(df_2025$Fecha, "%m") == "07", ]
print(df)
print(df_agosto)
total <- 0
aciertos <- 0
fechas_aciertos <- c()
hora_acierto <- c()
# Recorrer cada sorteo de agosto
for (i in seq_len(nrow(df_agosto))) {
fecha_actual <- df_agosto$Fecha[i]
num_actual <- df_agosto$Número[i]
# Índices del sorteo actual dentro de df_2025 (puede haber más de uno)
idx_2025_vec <- which(df_2025$Fecha == fecha_actual & df_2025$Número == num_actual)
if (length(idx_2025_vec) == 0) next
for (idx_2025 in idx_2025_vec) {
if (idx_2025 == nrow(df_2025)) next  # No hay siguiente sorteo
num_siguiente <- df_2025$Número[idx_2025 + 1]
fecha_siguiente <- df_2025$Fecha[idx_2025 + 1]
hora_siguiente <- df_2025$Hora[idx_2025 + 1]
print(num_siguiente)
# Buscar vecinos en sorteos anteriores a la fecha actual
df_antes <- df[df$Fecha < fecha_actual, ]
posiciones <- which(df_antes$Número == num_actual)
vecinos <- c()
for (pos in posiciones) {
ini <- max(1, pos - n_ventana)
fin <- min(nrow(df_antes), pos + n_ventana)
ventana <- df_antes$Número[ini:fin]
ventana <- ventana[ventana != num_actual]
vecinos <- c(vecinos, ventana)
}
if (length(vecinos) == 0) next
tabla_vecinos <- sort(table(vecinos), decreasing = TRUE)
vecinos_rango <- tabla_vecinos[seq(n_vecinos_min, min(n_vecinos_max, length(tabla_vecinos)))]
vecinos_seleccionados <- as.integer(names(vecinos_rango))
total <- total + 1
if (num_siguiente %in% vecinos_seleccionados) {
aciertos <- aciertos + 1
fechas_aciertos <- c(fechas_aciertos, fecha_siguiente)
hora_acierto <- c(hora_acierto, hora_siguiente)
}
}
}
return(list(
total = total,
aciertos = aciertos,
porcentaje_aciertos = ifelse(total > 0, round(100 * aciertos / total, 2), NA),
fechas_aciertos = as.Date(fechas_aciertos),
horas_aciertos = hora_acierto
))
}
simular_vecinos_sorteos_2025(tica, n_vecinos_min = 1, n_vecinos_max = 20, n_ventana = 1)
simular_vecinos_sorteos_2025(nica, n_vecinos_min = 1, n_vecinos_max = 20, n_ventana = 10)
library(data.table)
simular_vecinos_sorteos_2025_parallel <- function(resultados, predecir, n_vecinos_min = 5, n_vecinos_max = 15, n_ventana = 1, workers = 1) {
resultados <- copy(resultados)
predecir <- copy(predecir)
setDT(resultados)
setDT(predecir)
resultados[, Fecha := as.Date(Fecha)]
predecir[, Fecha := as.Date(Fecha)]
resultados[, Número := as.character(as.numeric(Número))]
predecir[, Número := as.character(as.numeric(Número))]
setorder(resultados, Fecha)
setorder(predecir, Fecha)
numeros_res <- resultados$Número
fechas_res_vec <- resultados$Fecha
n <- nrow(predecir)
# SIN paralelismo
resultados_list <- lapply(1:(n-1), function(i) {
fecha_actual <- predecir$Fecha[i]
num_actual <- predecir$Número[i]
num_siguiente <- predecir$Número[i + 1]
fecha_siguiente <- predecir$Fecha[i + 1]
hora_siguiente <- predecir$Hora[i + 1]
posibles_indices <- which(fechas_res_vec < fecha_actual)
if (length(posibles_indices) == 0) return(NULL)
idx_fin <- max(posibles_indices)
resultados_antes_indices <- 1:idx_fin
posiciones <- which(numeros_res[resultados_antes_indices] == num_actual)
if (length(posiciones) == 0) return(NULL)
vecinos_lista <- lapply(posiciones, function(pos) {
ini <- max(1, pos - n_ventana)
fin <- min(idx_fin, pos + n_ventana)
ventana <- numeros_res[ini:fin]
ventana[ventana != num_actual]
})
vecinos <- unlist(vecinos_lista, use.names = FALSE)
if (length(vecinos) == 0) return(NULL)
tabla_vecinos <- sort(table(vecinos), decreasing = TRUE)
start_idx <- ifelse(n_vecinos_min <= length(tabla_vecinos), n_vecinos_min, 1)
end_idx <- min(n_vecinos_max, length(tabla_vecinos))
vecinos_rango <- names(tabla_vecinos)[start_idx:end_idx]
acierto <- num_siguiente %in% vecinos_rango
if (acierto) {
list(acierto = TRUE, fecha = fecha_siguiente, hora = hora_siguiente)
} else {
list(acierto = FALSE)
}
})
# Procesar resultados
aciertos <- sum(sapply(resultados_list, function(x) !is.null(x) && x$acierto))
total <- sum(sapply(resultados_list, Negate(is.null)))
fechas_aciertos <- unlist(lapply(resultados_list, function(x) if(!is.null(x) && x$acierto) x$fecha else NULL))
horas_aciertos <- unlist(lapply(resultados_list, function(x) if(!is.null(x) && x$acierto) x$hora else NULL))
list(
total = total,
aciertos = aciertos,
porcentaje_aciertos = ifelse(total > 0, round(100 * aciertos / total, 2), NA),
fechas_aciertos = as.Date(fechas_aciertos),
horas_aciertos = horas_aciertos
)
}
simular_vecinos_sorteos_2025_parallel(tica, nica, 1, 10, 5, 1)
