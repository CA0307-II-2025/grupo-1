resultados_base <- tica %>% filter(format(Fecha, "%Y") %in% as.character(anios))
anio_max <- max(anios)
predecir <- tica %>% filter(format(Fecha, "%Y") == as.character(anio_max))
if (nrow(resultados_base) == 0 || nrow(predecir) < 2) return(NULL)
res <- simular_vecinos_sorteos_2025_parallel(
resultados = resultados_base,
predecir = nica,
n_vecinos_min = n_min,
n_vecinos_max = n_max,
n_ventana = ventana,
workers = 1
)
saveRDS(res, file = sprintf("resultados_temp/res_%d.rds", id_actual))
NULL
}
)
archivos_finales <- list.files("resultados_temp", pattern = "^res_\\d+\\.rds$", full.names = TRUE)
todos_los_resultados <- map_dfr(archivos_finales, function(file) {
id <- as.integer(gsub("res_(\\d+)\\.rds", "\\1", basename(file)))
res <- readRDS(file)
tibble(
id = id,
total = if (!is.null(res)) res$total else NA,
aciertos = if (!is.null(res)) res$aciertos else NA,
porcentaje_aciertos = if (!is.null(res)) res$porcentaje_aciertos else NA
)
}) %>%
left_join(parametros, by = "id") %>%
select(id, n_vecinos_min, n_vecinos_max, n_ventana, anios_chr,
total, aciertos, porcentaje_aciertos)
